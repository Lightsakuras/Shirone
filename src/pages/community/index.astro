---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { communityConfig } from "@/config/communityConfig";

if (!communityConfig.enable)
	return Astro.redirect(`${import.meta.env.BASE_URL}404/`);
const CommunityIsland = (
	await import("@components/organisms/community/CommunityIsland.astro")
).default;
const title = i18n(I18nKey.communityTitle);
---
<MainGridLayout title={title} description={i18n(I18nKey.communityIntro)} page="community">
    <div class="p-4 md:p-8 rounded-[var(--shape-corner-l)] bg-[var(--surface-container-lowest)] min-w-0">
        <CommunityIsland config={communityConfig} mode="feed" />
    </div>
</MainGridLayout>
