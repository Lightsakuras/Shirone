---
import { creativeAudioTracks } from "@/data/creative-audio";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
---
<details class="creative-audio" id="creative-audio" data-play={i18n(I18nKey.creativeAudioPlay)} data-pause={i18n(I18nKey.creativeAudioPause)} data-playing-label={i18n(I18nKey.creativeAudioPlaying)} data-paused={i18n(I18nKey.creativeAudioPaused)} data-error={i18n(I18nKey.creativeAudioError)}>
  <summary><span class="audio-orbit" aria-hidden="true">♫</span><span>{i18n(I18nKey.creativeAudioTitle)}</span><span class="audio-bars" aria-hidden="true"><i></i><i></i><i></i></span></summary>
  <div class="audio-body">
    <p class="audio-note">{i18n(I18nKey.creativeAudioNote)}</p>
    <label class="audio-label" for="creative-audio-track">{i18n(I18nKey.creativeAudioTrack)}</label>
    <select id="creative-audio-track">{creativeAudioTracks.map(track => <option value={track.source}>{track.title}</option>)}</select>
    <div class="audio-controls"><button type="button" data-audio-toggle aria-pressed="false">{i18n(I18nKey.creativeAudioPlay)}</button><button type="button" data-audio-next>{i18n(I18nKey.creativeAudioNext)}</button></div>
    <label class="audio-volume" for="creative-audio-volume">{i18n(I18nKey.creativeAudioVolume)}<input id="creative-audio-volume" type="range" min="0" max="1" step="0.01" value="0.22" /></label>
    <p class="audio-status" role="status" aria-live="polite">{i18n(I18nKey.creativeAudioPaused)}</p>
    <audio preload="none"></audio>
    <noscript><audio controls preload="none" src={creativeAudioTracks[0].source}></audio></noscript>
  </div>
</details>
<script>
  function mountCreativeAudio() {
    const root = document.querySelector<HTMLElement>("#creative-audio");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";
    const audio = root.querySelector<HTMLAudioElement>("audio")!;
    const select = root.querySelector<HTMLSelectElement>("select")!;
    const toggle = root.querySelector<HTMLButtonElement>("[data-audio-toggle]")!;
    const volume = root.querySelector<HTMLInputElement>("input")!;
    const status = root.querySelector<HTMLElement>("[role=status]")!;
    audio.volume = .22;
    let intent = 0;
    let requestedPlaying = false;
    const update = () => {
      const playing = !audio.paused && !audio.ended;
      root.dataset.playing = String(playing);
      toggle.textContent = playing ? root.dataset.pause! : root.dataset.play!;
      toggle.setAttribute("aria-pressed", String(playing));
      status.textContent = playing ? root.dataset.playingLabel! : root.dataset.paused!;
    };
    async function play() {
      const id = ++intent;
      requestedPlaying = true;
      if (!audio.getAttribute("src")) audio.src = select.value;
      try { await audio.play(); }
      catch (error) {
        if (id !== intent) return;
        requestedPlaying = false;
        update();
        if (!(error instanceof DOMException && error.name === "AbortError")) status.textContent = root!.dataset.error!;
      }
    }
    toggle.addEventListener("click", () => {
      if (requestedPlaying || !audio.paused) { ++intent; requestedPlaying = false; audio.pause(); update(); }
      else void play();
    });
    const change = (start: boolean) => {
      ++intent; requestedPlaying = false; audio.pause(); audio.src = select.value; audio.load(); update();
      if (start) void play();
    };
    select.addEventListener("change", () => change(!audio.paused || requestedPlaying));
    root.querySelector("[data-audio-next]")!.addEventListener("click", () => { select.selectedIndex = (select.selectedIndex + 1) % select.options.length; change(!audio.paused || requestedPlaying); });
    volume.addEventListener("input", () => { audio.volume = Number(volume.value); });
    audio.addEventListener("playing", () => { requestedPlaying = true; update(); });
    audio.addEventListener("pause", update);
    audio.addEventListener("ended", () => { select.selectedIndex = (select.selectedIndex + 1) % select.options.length; change(true); });
    audio.addEventListener("error", () => { requestedPlaying = false; update(); status.textContent = root.dataset.error!; });
    // Mount outside #swup-container so internal navigation does not restart audio.
  }
  mountCreativeAudio();
  document.addEventListener("astro:page-load", mountCreativeAudio);
</script>
<style>
  .creative-audio { position: fixed; z-index: 55; left: max(1rem, env(safe-area-inset-left)); bottom: max(1rem, env(safe-area-inset-bottom)); max-width: calc(100vw - 2rem); color: var(--on-surface); background: var(--surface-container-low); border: 1px solid var(--outline-variant); border-radius: var(--shape-corner-xl); box-shadow: 0 .5rem 2rem var(--shadow); font: var(--m3e-type-body-medium); }
  summary { display: flex; gap: .65rem; align-items: center; min-height: 48px; padding: .35rem 1rem; cursor: pointer; list-style: none; font-weight: 600; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  .audio-orbit { color: var(--primary); font-size: 1.3rem; }
  .audio-bars { display: flex; height: 18px; gap: 3px; align-items: center; }
  .audio-bars i { display: block; width: 3px; height: 5px; border-radius: var(--shape-corner-full); background: var(--primary); }
  [data-playing="true"] .audio-bars i { animation: audio-pulse 1.1s ease-in-out infinite alternate; }
  .audio-bars i:nth-child(2) { animation-delay: -.4s; }.audio-bars i:nth-child(3) { animation-delay: -.7s; }
  .audio-body { width: min(310px, calc(100vw - 2.2rem)); padding: .2rem 1rem 1rem; }
  .audio-note { font-size: .75rem; line-height: 1.6; color: var(--on-surface-variant); margin: .25rem 0 .8rem; }
  .audio-label { display: block; font-size: .8rem; margin-bottom: .3rem; }
  select { max-width: 100%; width: 100%; min-height: 44px; padding: .5rem; border: 1px solid var(--outline-variant); border-radius: var(--shape-corner-m); color: var(--on-surface); background: var(--surface-container); }
  .audio-controls { display: flex; gap: .5rem; margin: .7rem 0; }
  button { flex: 1; min-height: 44px; border-radius: var(--shape-corner-m); border: 0; background: var(--primary-container); color: var(--on-primary-container); cursor: pointer; font: inherit; font-size: .85rem; }
  button:hover { background: var(--secondary-container); color: var(--on-secondary-container); }
  .audio-volume { display: flex; gap: .8rem; align-items: center; font-size: .8rem; }
  input { width: 100%; min-width: 0; min-height: 32px; accent-color: var(--primary); }
  .audio-status { margin: .4rem 0 0; color: var(--on-surface-variant); font-size: .75rem; }
  @keyframes audio-pulse { to { height: 17px; } }
  @media (prefers-reduced-motion: reduce) { [data-playing="true"] .audio-bars i { animation: none; height: 12px; } }
</style>
