---
import Key from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import data from "../../../../public/assets/creative/projects.json";
interface Props {
	id: string;
}
const { id } = Astro.props;
const section = data.sections.find((s) => s.id === id)!;
const chapters = section.chapters || [];
const items = section.items || [];
const cover = chapters.length ? chapters[0].pages[0] : items[0];
---
<article class="creative-story">
 <a class="creative-text-link" href="/worlds/">← {i18n(Key.creativeBack)}</a>
 <header><p class="creative-kicker">{section.eyebrow}</p><h1>{section.title}</h1><p class="creative-story__intro">{section.description}</p></header>
 {cover && <img class="creative-story__cover" src={cover.src} alt={section.subtitle} width={cover.width} height={cover.height} decoding="async" />}
 <nav class="creative-chapter-nav" aria-label={i18n(Key.creativeChapters)}>{chapters.map((c,i)=><a href={`#${c.id}`}>{String(i+1).padStart(2,'0')} · {c.title}</a>)}{items.map((item,i)=><a href={`#${item.id}`}>{String(i+1).padStart(2,'0')} · {item.title}</a>)}</nav>
 {chapters.map((chapter,i)=><section class="creative-chapter" id={chapter.id}><header><span class="creative-kicker">{String(i+1).padStart(2,'0')}</span><div><h2>{chapter.title}</h2><p>{chapter.summary}</p></div></header><div class="comic-pages">{chapter.pages.map(page=><figure><a href={page.src} target="_blank" rel="noopener" aria-label={`${i18n(Key.creativeViewImage)} · ${page.title}`} data-no-swup><img src={page.src} alt={page.title} width={page.width} height={page.height} loading="lazy" decoding="async" /></a><figcaption>{page.title}</figcaption></figure>)}</div></section>)}
 {items.map((item,i)=><section class="creative-chapter" id={item.id}><header><span class="creative-kicker">{String(i+1).padStart(2,'0')}</span><div><h2>{item.title}</h2><p>{item.caption}</p></div></header><figure><a href={item.src} target="_blank" rel="noopener" aria-label={`${i18n(Key.creativeViewImage)} · ${item.title}`} data-no-swup><img src={item.src} alt={item.title} width={item.width} height={item.height} loading="lazy" decoding="async" /></a><figcaption>{item.status}</figcaption></figure></section>)}
 {section.note && <p class="creative-footer-note">{section.note}</p>}
 <p class="creative-footer-note">{data.credits}</p>
</article>
